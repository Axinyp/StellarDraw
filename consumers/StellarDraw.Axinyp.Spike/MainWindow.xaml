<Window x:Class="StellarDraw.Axinyp.Spike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Axinyp.Wpf.Hosting.Wpf.Localization;assembly=Axinyp.Wpf.Hosting.Wpf"
        Title="{loc:Loc MainWindow.Title}"
        Width="1280"
        Height="800"
        MinWidth="800"
        MinHeight="500">
    <DockPanel Background="{DynamicResource App.BackgroundBrush}">
        <Border DockPanel.Dock="Top"
                Margin="12,12,12,8"
                Padding="12"
                Background="#14000000"
                BorderBrush="#22000000"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource App.ForegroundBrush}"
                           Text="{loc:Loc MainWindow.Title}" />
                <ContentControl x:Name="StatusRegionHost"
                                Margin="0,6,0,0" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="{DynamicResource App.ForegroundBrush}"
                           Opacity="0.82"
                           Text="{Binding Status}" />
            </StackPanel>
        </Border>

        <Border Margin="12,0,12,12"
                Background="White"
                BorderBrush="#22000000"
                BorderThickness="1"
                CornerRadius="8">
            <ContentControl x:Name="PluginHost" />
        </Border>
    </DockPanel>
</Window>
