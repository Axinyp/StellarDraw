    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>StellarDraw.Axinyp.Spike</RootNamespace>
    <AssemblyName>StellarDraw.Axinyp.Spike</AssemblyName>
    <StartupObject>StellarDraw.Axinyp.Spike.App</StartupObject>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
