    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Axinyp.Wpf.Hosting" Version="1.0.0" />
    <PackageReference Include="Axinyp.Wpf.Hosting.Wpf" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WhiteBoard.Contracts\WhiteBoard.Contracts.csproj" />
    <ProjectReference Include="..\..\src\WhiteBoard.Contracts.Wpf\WhiteBoard.Contracts.Wpf.csproj" />
  </ItemGroup>
</Project>
