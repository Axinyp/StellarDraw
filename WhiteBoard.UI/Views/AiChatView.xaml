<UserControl x:Class="WhiteBoard.UI.Views.AiChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WhiteBoard.UI.ViewModels"
             xmlns:conv="clr-namespace:WhiteBoard.UI.Views"
             MinWidth="280" Background="#F8F9FA">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:InverseBoolConverter x:Key="NegBool"/>

        <Style x:Key="UserBubble" TargetType="Border">
            <Setter Property="Background" Value="#1A73E8"/>
            <Setter Property="CornerRadius" Value="12,12,2,12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="40,2,4,2"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MaxWidth" Value="240"/>
        </Style>

        <Style x:Key="AiBubble" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12,12,12,2"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4,2,40,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MaxWidth" Value="240"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#757575"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EEEEEE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SendBtn" TargetType="Button">
            <Setter Property="Background" Value="#1A73E8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#B0BEC5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1558B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>

        <!-- 顶部标题栏 -->
        <Border DockPanel.Dock="Top"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="清空"
                        Command="{Binding ClearCommand}"
                        Style="{StaticResource ActionBtn}"
                        FontSize="12"
                        Visibility="{Binding ShowSettings, Converter={StaticResource InvBoolToVis}}"/>
                <Button DockPanel.Dock="Right"
                        Content="⚙"
                        Command="{Binding ToggleSettingsCommand}"
                        Style="{StaticResource ActionBtn}"
                        FontSize="14"
                        ToolTip="AI 设置"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AI 对话"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="#424242"
                               Visibility="{Binding ShowSettings, Converter={StaticResource InvBoolToVis}}"/>
                    <TextBlock Text="AI 设置"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="#424242"
                               Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVis}}"/>
                    <!-- MCP 活动指示 -->
                    <Border Background="#E8F5E9"
                            CornerRadius="8"
                            Padding="6,2"
                            Margin="8,0,0,0"
                            Visibility="{Binding HasMcpActivity, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="10" Foreground="#2E7D32"
                                   Text="{Binding McpActiveConnections,
                                                  StringFormat='MCP {0}'}"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 底部输入区域（设置页打开时隐藏） -->
        <Border DockPanel.Dock="Bottom"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0"
                Padding="8"
                Visibility="{Binding ShowSettings, Converter={StaticResource InvBoolToVis}}">
            <StackPanel>
                <!-- 确认对话框 -->
                <Border Background="#FFF3E0"
                        BorderBrush="#FFB74D"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8"
                        Margin="0,0,0,6"
                        Visibility="{Binding ConfirmVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ConfirmMessage}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="#BF360C"
                                   Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消"
                                    Command="{Binding ConfirmCancelCommand}"
                                    Style="{StaticResource ActionBtn}"
                                    Margin="0,0,8,0"/>
                            <Button Content="确认执行"
                                    Command="{Binding ConfirmOkCommand}"
                                    Style="{StaticResource SendBtn}"
                                    Background="#E53935"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 工具状态条 -->
                <TextBlock Text="{Binding StatusBarText}"
                           FontSize="11"
                           Foreground="#F57F17"
                           Margin="2,0,0,4"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding ShowStatusBar, Converter={StaticResource BoolToVis}}"/>

                <!-- 输入行 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- PTT 按钮 -->
                    <Button Grid.Column="0"
                            x:Name="PttBtn"
                            Content="🎙"
                            Style="{StaticResource ActionBtn}"
                            Margin="0,0,4,0"
                            ToolTip="按下说话（Push-to-Talk）"
                            IsEnabled="{Binding IsProcessing, Converter={StaticResource NegBool}}"
                            PreviewMouseLeftButtonDown="PttBtn_MouseDown"
                            PreviewMouseLeftButtonUp="PttBtn_MouseUp">
                    </Button>

                    <!-- 文字输入框 -->
                    <Border Grid.Column="1"
                            BorderBrush="#BDBDBD"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=InputBox, Path=IsFocused}" Value="True">
                                        <Setter Property="BorderBrush" Value="#1A73E8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBox x:Name="InputBox"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="False"
                                 VerticalAlignment="Center"
                                 FontSize="13"
                                 Padding="6,5"
                                 BorderThickness="0"
                                 Background="Transparent">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SendCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </Border>

                    <!-- 中断按钮 -->
                    <Button Grid.Column="2"
                            Content="■"
                            Command="{Binding InterruptCommand}"
                            Style="{StaticResource ActionBtn}"
                            Foreground="#E53935"
                            Margin="4,0"
                            ToolTip="中断"
                            Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"/>

                    <!-- 发送按钮 -->
                    <Button Grid.Column="3"
                            Content="发送"
                            Command="{Binding SendCommand}"
                            Style="{StaticResource SendBtn}"
                            IsEnabled="{Binding CanSend}"
                            Visibility="{Binding IsProcessing, Converter={StaticResource InvBoolToVis}}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 消息列表与设置面板共享剩余空间，通过 Visibility 切换 -->
        <Grid>
            <ScrollViewer x:Name="MessagesScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,4"
                          Visibility="{Binding ShowSettings, Converter={StaticResource InvBoolToVis}}">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AiChatViewModel+ChatMessage}">
                            <Grid Margin="0,1">
                                <!-- 用户消息 -->
                                <Border Style="{StaticResource UserBubble}"
                                        Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="White"
                                               FontSize="13"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <!-- AI / 系统消息 -->
                                <Border Style="{StaticResource AiBubble}"
                                        Visibility="{Binding IsUser, Converter={StaticResource InvBoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Author}"
                                                   FontSize="10"
                                                   Foreground="#9E9E9E"
                                                   Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding Text}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#212121"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Foreground" Value="#E53935"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 设置面板（ShowSettings = true 时显示） -->
            <conv:AiSettingsView DataContext="{Binding SettingsVm}"
                                 Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVis}}"/>
        </Grid>

    </DockPanel>
</UserControl>
