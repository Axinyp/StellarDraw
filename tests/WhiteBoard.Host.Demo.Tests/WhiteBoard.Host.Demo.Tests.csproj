<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WhiteBoard.Contracts\WhiteBoard.Contracts.csproj" />
    <ProjectReference Include="..\..\src\WhiteBoard.Contracts.Wpf\WhiteBoard.Contracts.Wpf.csproj" />
    <ProjectReference Include="..\..\src\WhiteBoard.Core\WhiteBoard.Core.csproj" />
    <ProjectReference Include="..\..\src\WhiteBoard.UI\WhiteBoard.UI.csproj" />
    <Compile Include="..\..\src\WhiteBoard.Host.Demo\PluginManager.cs" Link="PluginManager.cs" />
    <Compile Include="..\..\src\WhiteBoard.Host.Demo\WhiteboardPluginContext.cs" Link="WhiteboardPluginContext.cs" />
    <Compile Include="..\..\src\WhiteBoard.Host.Demo\InMemoryMessageBus.cs" Link="InMemoryMessageBus.cs" />
    <Compile Include="..\..\src\WhiteBoard.Host.Demo\MockHostCapabilities.cs" Link="MockHostCapabilities.cs" />
    <ProjectReference Include="..\..\src\WhiteBoard.Plugin\WhiteBoard.Plugin.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

  <Target Name="CopyRuntimePluginToTestOutput" AfterTargets="Build">
    <PropertyGroup>
      <PluginSrcDir>$(MSBuildThisFileDirectory)..\..\src\WhiteBoard.Plugin\bin\$(Configuration)\net10.0-windows\</PluginSrcDir>
      <PluginDestDir>$(OutputPath)plugins\whiteboard\</PluginDestDir>
    </PropertyGroup>
    <ItemGroup>
      <PluginFiles Include="$(PluginSrcDir)**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(PluginDestDir)" />
    <Copy SourceFiles="@(PluginFiles)"
          DestinationFiles="@(PluginFiles->'$(PluginDestDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
