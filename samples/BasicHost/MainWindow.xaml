<Window
    x:Class="Axinyp.Wpf.Hosting.Samples.BasicHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:Axinyp.Wpf.Hosting.Wpf.Localization;assembly=Axinyp.Wpf.Hosting.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{loc:Loc MainWindow.Title}"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid Background="{DynamicResource App.BackgroundBrush}">
        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="18"
            Foreground="{DynamicResource App.ForegroundBrush}"
            Text="{loc:Loc MainWindow.Title}" />
    </Grid>
</Window>
