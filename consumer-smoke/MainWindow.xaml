<Window x:Class="ConsumerSmoke.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Axinyp.Wpf.Hosting.Wpf.Localization;assembly=Axinyp.Wpf.Hosting.Wpf"
        Title="{loc:Loc MainWindow.Title}"
        Width="640"
        Height="360">
    <Grid Background="{DynamicResource App.BackgroundBrush}">
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="18"
                   Foreground="{DynamicResource App.ForegroundBrush}"
                   Text="{loc:Loc MainWindow.Title}" />
    </Grid>
</Window>
