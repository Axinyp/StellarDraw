        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="18"
                   Foreground="{DynamicResource App.ForegroundBrush}"
                   Text="{loc:Loc ClientHome.NavigationReady}" />
    </Grid>
</UserControl>
