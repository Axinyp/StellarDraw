<Window
    x:Class="WhiteBoard.Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WhiteBoard.UI.Controls;assembly=WhiteBoard.UI"
    Title="{Binding Title}"
    Width="1280"
    Height="800"
    MinWidth="800"
    MinHeight="560"
    Background="{DynamicResource App.BackgroundBrush}">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Command="{Binding OpenCommand}" Content="打开" Margin="4,0" />
            <Button Command="{Binding SaveAsCommand}" Content="另存为" Margin="4,0" />
            <Separator />
            <TextBlock VerticalAlignment="Center" Foreground="#555" Text="{Binding StatusMessage}" />
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom" Height="24">
            <StatusBarItem>
                <TextBlock Foreground="#666" Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>

        <controls:PageStrip DockPanel.Dock="Bottom" ViewModel="{Binding Board}" />
        <controls:InkToolbar DockPanel.Dock="Top"
                             ViewModel="{Binding Board.Toolbar}"
                             Board="{Binding Board}" />

        <Border Margin="4" Background="White" BorderBrush="#DDD" BorderThickness="1">
            <controls:InkSurface x:Name="CanvasSurface"
                                 ViewModel="{Binding Board}"
                                 SizeChanged="OnCanvasSurfaceSizeChanged" />
        </Border>
    </DockPanel>
</Window>
