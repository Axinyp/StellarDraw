<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>WinExe</OutputType>
    <RootNamespace>WhiteBoard.Host.Demo</RootNamespace>
    <AssemblyName>WhiteBoard.Host.Demo</AssemblyName>
    <StartupObject>WhiteBoard.Host.Demo.App</StartupObject>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WhiteBoard.Contracts\WhiteBoard.Contracts.csproj" />
    <ProjectReference Include="..\WhiteBoard.Contracts.Wpf\WhiteBoard.Contracts.Wpf.csproj" />
    <!-- WhiteBoard.Protocol 在 SharedAssemblies 中，ALC 委托给 Default Context 加载，
         因此 Host 输出目录必须包含该 DLL -->
    <ProjectReference Include="..\WhiteBoard.Protocol\WhiteBoard.Protocol.csproj" />
    <!-- WhiteBoard.UI 传递引入 Core + AI，Host 通过 SharedAssemblies 与 Plugin 共享这些程序集 -->
    <ProjectReference Include="..\WhiteBoard.UI\WhiteBoard.UI.csproj" />
    <!-- MCP 内嵌服务宿主 wiring 所需（EmbeddedMcpServerHost / McpSessionRegistry / TokenFactory） -->
    <ProjectReference Include="..\WhiteBoard.Mcp.Core\WhiteBoard.Mcp.Core.csproj" />
    <!-- 编译时不引用，但确保 Plugin 先于 Host 构建 -->
    <ProjectReference Include="..\WhiteBoard.Plugin\WhiteBoard.Plugin.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

  <!-- 构建后将 Plugin 所有输出复制到 plugins/whiteboard/ 子目录 -->
  <Target Name="CopyPluginToPluginsDir" AfterTargets="Build">
    <PropertyGroup>
      <PluginSrcDir>$(MSBuildThisFileDirectory)..\WhiteBoard.Plugin\bin\$(Configuration)\net10.0-windows\</PluginSrcDir>
      <PluginDestDir>$(OutputPath)plugins\whiteboard\</PluginDestDir>
    </PropertyGroup>
    <ItemGroup>
      <PluginFiles Include="$(PluginSrcDir)**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(PluginDestDir)" />
    <Copy SourceFiles="@(PluginFiles)"
          DestinationFiles="@(PluginFiles->'$(PluginDestDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
