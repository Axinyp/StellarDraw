<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WhiteBoard.Framework.Hosting</RootNamespace>
    <AssemblyName>WhiteBoard.Framework.Hosting</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- 通用主机 + DI + 配置（Hosting 传递引入 DI/Configuration/Logging 抽象与实现） -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <!-- MVVM 基元（ObservableObject / RelayCommand / 源生成器），供上层宿主与模块复用 -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

</Project>
