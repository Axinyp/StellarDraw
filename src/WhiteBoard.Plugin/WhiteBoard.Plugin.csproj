<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WhiteBoard.Plugin</RootNamespace>
    <AssemblyName>WhiteBoard.Plugin</AssemblyName>
    <!-- Force NuGet package DLLs to be copied to output — required for AssemblyLoadContext plugin isolation -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.0" />
    <!-- Transitive deps from WhiteBoard.Core — must be explicit to ensure DLLs land in plugin output -->
    <PackageReference Include="RBush" Version="3.1.0" />
    <PackageReference Include="System.IO.Hashing" Version="9.0.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WhiteBoard.Contracts\WhiteBoard.Contracts.csproj" />
    <ProjectReference Include="..\WhiteBoard.Contracts.Wpf\WhiteBoard.Contracts.Wpf.csproj" />
    <ProjectReference Include="..\WhiteBoard.Core\WhiteBoard.Core.csproj" />
    <ProjectReference Include="..\WhiteBoard.Protocol\WhiteBoard.Protocol.csproj" />
    <ProjectReference Include="..\WhiteBoard.UI\WhiteBoard.UI.csproj" />
  </ItemGroup>
</Project>
