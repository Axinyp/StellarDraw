<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <UseWPF Condition="'$(TargetFramework)' == 'net10.0-windows'">true</UseWPF>
    <RootNamespace>Axinyp.Wpf.Hosting.Abstractions</RootNamespace>
    <AssemblyName>Axinyp.Wpf.Hosting.Abstractions</AssemblyName>
    <PackageId>Axinyp.Wpf.Hosting.Abstractions</PackageId>
    <Description>通用 WPF 宿主稳定契约层，承载模块、生命周期、插件、设置、本地化与部分 WPF 扩展抽象。</Description>
    <PackageTags>hosting;abstractions;modular;plugin;wpf;mvvm</PackageTags>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="Wpf\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
