<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WhiteBoard.AI</RootNamespace>
    <AssemblyName>WhiteBoard.AI</AssemblyName>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TinyPinyin.Net" Version="1.0.2" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <ProjectReference Include="..\WhiteBoard.Core\WhiteBoard.Core.csproj" />
    <ProjectReference Include="..\WhiteBoard.Contracts\WhiteBoard.Contracts.csproj" />
    <ProjectReference Include="..\WhiteBoard.Protocol\WhiteBoard.Protocol.csproj" />
    <!-- LLM: ME.AI 10.7.0 + OpenAI 2.11.0 -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.7.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.7.0" />
    <PackageReference Include="OpenAI" Version="2.11.0" />
    <!-- Voice Pipeline: WASAPI microphone + WAV encoding -->
    <PackageReference Include="NAudio" Version="2.1.0" />
    <!-- Windows Speech API (System.Speech): requires net-windows TFM -->
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>
</Project>
